{
  "name": "@gruu6y/page-clean-login",
  "version": "0.1.100",
  "description": "在 magpie 中管理代理 IP 与供应商登录，每个账号通过独立浏览器身份登录；一个带仅回环主机服务的页面插件。",
  "license": "MIT",
  "type": "module",
  "main": "./index.mjs",
  "bin": {
    "clean-login": "bin/clean-login.mjs"
  },
  "files": [
    "index.mjs",
    "lib",
    "bin",
    "page",
    "ui",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-page",
    "magpie-plugin",
    "proxy",
    "provider",
    "sign-in",
    "browser-profile"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gruu6y/magpie-clean-login.git"
  },
  "bugs": {
    "url": "https://github.com/Gruu6y/magpie-clean-login/issues"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "camoufox": "0.5.9",
    "fpgen-js": "1.3.0",
    "playwright-core": "1.62.0"
  },
  "magpie": {
    "icon": "https://raw.githubusercontent.com/Gruu6y/magpie-clean-login/main/assets/icon.svg",
    "page": {
      "title": "Clean Login",
      "titles": {
        "zh": "干净登录",
        "zh-TW": "乾淨登入",
        "ja": "クリーンログイン"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 3492,
        "option": "port"
      }
    },
    "permissions": [
      "providers:list"
    ],
    "options": {
      "port": 3492
    }
  },
  "scripts": {
    "test": "bun test"
  }
}
